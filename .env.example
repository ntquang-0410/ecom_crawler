WORKER_ID=worker_xxxxx

# --- Hugging Face Hub -------------------------------------------------------
# Generate a "Write" access token at https://huggingface.co/settings/tokens
# Rotate it immediately if it was ever pasted into chat, email, or logs.
HF_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Plain "<user>/<name>" id, NOT a git/ssh URL.
HF_REPO_ID=ntquang0410/zh-vie_ecom
HF_REPO_TYPE=dataset

# --- Central Queue (Firebase Realtime Database) -----------------------------
# Path to the downloaded Firebase service-account JSON key file (per member).
FIREBASE_CRED_PATH=./firebase-credentials.json
FIREBASE_DB_URL=https://ecom-crawler-70461-default-rtdb.asia-southeast1.firebasedatabase.app/
FIREBASE_QUEUE_PATH=queue_search_zh

# --- Crawler tuning ----------------------------------------------------------
BATCH_SIZE=1000
# Each queue item is one 1688 search page (~60 products, ~5-8s). Keep the
# chunk small so a chunk finishes well inside LOCK_TIMEOUT_SECONDS.
CLAIM_CHUNK_SIZE=10
MAX_CONCURRENT_REQUESTS=20
REQUEST_TIMEOUT_SECONDS=60
MAX_CRAWL_ATTEMPTS=3
DEFAULT_CATEGORY=electronics

# --- Crawler engine selection -------------------------------------------------
# "1688_search": real Chrome (must be installed on the machine) with a
#   persistent profile at BROWSER_PROFILE_DIR. First run: solve the slider
#   CAPTCHA and log in to 1688/Taobao in the Chrome window once; cookies are
#   kept in the profile for later runs. Needs `pip install playwright`.
# "aiohttp" / "playwright": legacy engines, both blocked by Alibaba's anti-bot.
CRAWLER_ENGINE=1688_search
BROWSER_PROFILE_DIR=.pw_profile
HUMAN_WAIT_SECONDS=300
PLAYWRIGHT_HEADLESS=false

# --- Raw JSONL output (append-only, never edit) --------------------------------
RAW_DATA_DIR=data/raw
RAW_SHARD_MAX_MB=200
# Each Playwright request is a full browser tab -- keep this much lower
# than MAX_CONCURRENT_REQUESTS above.
PLAYWRIGHT_MAX_CONCURRENT_PAGES=4
PLAYWRIGHT_MIN_DELAY_SECONDS=1.0
PLAYWRIGHT_MAX_DELAY_SECONDS=3.0

# --- Upload resiliency (exponential backoff) ---------------------------------
MAX_UPLOAD_RETRIES=6
UPLOAD_BASE_DELAY_SECONDS=2
UPLOAD_MAX_DELAY_SECONDS=120

# --- Stale lock recovery ------------------------------------------------------
# Must exceed HUMAN_WAIT_SECONDS + one claim chunk, or another worker re-claims pages still in progress.
LOCK_TIMEOUT_SECONDS=1800

# Content language from 1688: zh = sellers' Chinese (corpus), vi = 1688 machine translation (silver only)
SITE_LANGUAGE=zh
